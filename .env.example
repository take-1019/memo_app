# ---- 保存先（任意。未設定ならメモリ保存＝再起動で消える） ----
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # 受信箱では未使用（既存の買い物リスト用）

# ---- アクセス制限（公開環境では必須） ----
INBOX_PASSWORD=
# Vercel Cron から /api/inbox/sync を叩く場合
CRON_SECRET=

# ---- Slack（Bot Token）----
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=            # Events API（即時反映）を使う場合

# ---- Chatwork ----
CHATWORK_API_TOKEN=

# ---- LINE 公式アカウント（Messaging API）----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ---- Discord（Bot）----
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ---- Microsoft Teams（Microsoft Graph・職場/学校アカウントのみ）----
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# MS_TENANT_ID=organizations     # シングルテナントで登録した場合はテナント ID
# MS_REDIRECT_URI=https://<ドメイン>/api/auth/microsoft/callback   # 未設定ならアクセス中のドメインから自動生成
# MS_ENABLE_CHANNELS=1           # チームのチャンネルも取り込む（管理者の同意が必要）
# INBOX_ENCRYPTION_KEY=          # ログイン情報の暗号化キー。未設定なら MS_CLIENT_SECRET から生成

# ---- 開発用 ----
# INBOX_FORCE_MEMORY_STORE=1     # Supabase が設定されていてもメモリ保存を使う
